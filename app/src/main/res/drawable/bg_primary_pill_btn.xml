<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#6694A3B8" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/cobalt_deep"
                        android:centerColor="@color/cobalt_bright"
                        android:endColor="@color/cobalt_deep"
                        android:type="linear" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
