<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface_bg"
    android:orientation="vertical">

    <!-- Compact Hero Header Bar -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_callbridge_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/brand_text_on_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderServiceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_stopped"
                android:textColor="@color/brand_text_on_dark_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDiagnostics"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/nav_diagnostics"
            android:textColor="@color/brand_text_on_dark"
            android:textSize="12sp"
            app:icon="@drawable/ic_terminal_log"
            app:iconSize="16dp"
            app:iconTint="@color/brand_text_on_dark"
            app:strokeColor="#33FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleLanguage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/action_switch_language"
            android:textColor="@color/brand_text_on_dark"
            android:textSize="12sp"
            app:strokeColor="#33FFFFFF" />
    </LinearLayout>

    <!-- 6-Screen Content Switcher -->
    <FrameLayout
        android:id="@+id/contentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/tabDashboard"
            layout="@layout/layout_tab_dashboard"
            android:visibility="visible" />

        <include
            android:id="@+id/tabMessages"
            layout="@layout/layout_tab_messages"
            android:visibility="gone" />

        <include
            android:id="@+id/tabContacts"
            layout="@layout/layout_tab_contacts"
            android:visibility="gone" />

        <include
            android:id="@+id/tabCalls"
            layout="@layout/layout_tab_calls"
            android:visibility="gone" />

        <include
            android:id="@+id/tabPairing"
            layout="@layout/layout_tab_pairing"
            android:visibility="gone" />

        <include
            android:id="@+id/tabDiagnostics"
            layout="@layout/layout_tab_diagnostics"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_card_bg"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
