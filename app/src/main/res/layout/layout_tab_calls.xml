<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Call State Readout -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_call_state"
            style="@style/Widget.CallBridge.MicroLabel" />

        <TextView
            android:id="@+id/tvCallState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IDLE"
            style="@style/Widget.CallBridge.HeroValue" />

        <TextView
            android:id="@+id/tvCallerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="—"
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp" />

        <!-- Primary Call Control Row (Answer / Reject / Hang Up) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAnswerCall"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_pill_btn"
                android:text="@string/action_answer"
                android:textColor="@color/brand_text_on_dark" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRejectCall"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_pill_btn"
                android:text="@string/action_reject"
                android:textColor="@color/brand_text_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHangupCall"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_pill_btn"
                android:text="@string/action_hangup"
                android:textColor="@color/status_error" />
        </LinearLayout>

        <!-- Secondary Dial / Default Dialer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDialNumber"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_pill_btn"
                android:text="@string/action_dial"
                android:textColor="@color/brand_text_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSetDefaultDialer"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_secondary_pill_btn"
                android:text="@string/action_set_default_dialer"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <!-- 2-Column Bento Tiles (Observed Calls + Capability) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_tile"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_observed_calls"
                    style="@style/Widget.CallBridge.MicroLabel" />

                <TextView
                    android:id="@+id/tvObservedCallsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0"
                    style="@style/Widget.CallBridge.TileValue"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_tile"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_call_control_cap"
                    style="@style/Widget.CallBridge.MicroLabel" />

                <TextView
                    android:id="@+id/tvCallCapability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="—"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Minimalist Audio Isolation & Mic Test Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/status_warn" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/section_audio_isolation"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic_audio"
                    app:tint="@color/brand_text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCellularAudioCap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="CELLULAR_AUDIO_UNAVAILABLE"
                android:textColor="@color/status_warn"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/audio_limitation_notice"
                android:textColor="@color/brand_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_mic_rms"
                    style="@style/Widget.CallBridge.MicroLabel" />

                <TextView
                    android:id="@+id/tvMicRmsLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="0"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartMicTest"
                    style="@style/Widget.CallBridge.PillAction"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_inner_card"
                    android:text="@string/action_start_mic_test"
                    android:textColor="@color/brand_primary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStopMicTest"
                    style="@style/Widget.CallBridge.PillAction"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_inner_card"
                    android:text="@string/action_stop_mic_test"
                    android:textColor="@color/brand_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Minimalist Play Creator Call Log Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/calllog_creator_notice"
            android:textColor="@color/brand_text_muted"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
