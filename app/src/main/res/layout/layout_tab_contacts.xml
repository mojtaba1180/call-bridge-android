<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Metric (Big Clean Contacts Count like Reference Balance) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_contacts_count"
            style="@style/Widget.CallBridge.MicroLabel" />

        <TextView
            android:id="@+id/tvContactsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textColor="@color/brand_text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/section_contacts_sync"
            android:textColor="@color/brand_text_secondary"
            android:textSize="12sp" />

        <!-- Dual Pill Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSyncContactsNow"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_pill_btn"
                android:text="@string/action_sync_contacts"
                android:textColor="@color/brand_text_on_dark" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddContact"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_pill_btn"
                android:text="@string/action_add_contact"
                android:textColor="@color/brand_text_primary" />
        </LinearLayout>

        <!-- 2-Column Bento Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_tile"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_contacts_observer"
                        style="@style/Widget.CallBridge.MicroLabel" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_contacts_sync"
                        app:tint="@color/brand_text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvContactsObserver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/status_inactive"
                    style="@style/Widget.CallBridge.TileValue"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_tile"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_contacts_conflicts"
                        style="@style/Widget.CallBridge.MicroLabel" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/brand_text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvContactsConflicts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="0"
                    style="@style/Widget.CallBridge.TileValue"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Minimalist Authority Info Tile + Permission Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/contacts_authority_notice"
                android:textColor="@color/brand_text_secondary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRequestContactsPermInTab"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_white_inner_card"
                android:text="@string/perm_contacts"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
