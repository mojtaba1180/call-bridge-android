<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Service Control & Master Sync Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvServiceStateDetail"
                    style="@style/Widget.CallBridge.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/service_stopped" />

                <TextView
                    android:id="@+id/tvDeviceApiSummary"
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Android" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartBridge"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_start_bridge"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopBridge"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_stop_bridge"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncAndroidToIphone"
                    style="@style/Widget.CallBridge.ActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_sync_all" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Connection, BLE, WSS & Sync Overview -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.CallBridge.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_connection" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_iphone_status" />
                <TextView
                    android:id="@+id/tvIphoneStatus"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_ble_status" />
                <TextView
                    android:id="@+id/tvBleStatus"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_inactive" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_wss_endpoint" />
                <TextView
                    android:id="@+id/tvWssEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="—"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_nsd_status" />
                <TextView
                    android:id="@+id/tvNsdStatus"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_inactive" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_sync_status" />
                <TextView
                    android:id="@+id/tvSyncStatus"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IDLE" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_sim_count" />
                <TextView
                    android:id="@+id/tvSimSummary"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions & Play Creator Compliance Checklist -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.CallBridge.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_permissions" />

                <!-- Bluetooth -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_bluetooth" />
                        <TextView
                            android:id="@+id/tvPermBluetooth"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantBluetooth"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- Phone State -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_phone_state" />
                        <TextView
                            android:id="@+id/tvPermPhoneState"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPhoneState"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- Contacts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_contacts" />
                        <TextView
                            android:id="@+id/tvPermContacts"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantContacts"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- Notifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_notifications" />
                        <TextView
                            android:id="@+id/tvPermNotifications"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantNotifications"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- Microphone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_microphone" />
                        <TextView
                            android:id="@+id/tvPermMicrophone"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantMicrophone"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- CALL_PHONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_call_phone" />
                        <TextView
                            android:id="@+id/tvPermCallPhone"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantCallPhone"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_grant" />
                </LinearLayout>

                <!-- Default Dialer Role -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_default_dialer" />
                        <TextView
                            android:id="@+id/tvPermDialerRole"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantDialerRole"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_configure" />
                </LinearLayout>

                <!-- Battery Optimization -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Widget.CallBridge.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_battery" />
                        <TextView
                            android:id="@+id/tvPermBattery"
                            style="@style/Widget.CallBridge.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_denied" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantBattery"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/action_configure" />
                </LinearLayout>

                <!-- Play Creator Compliance Summary Row -->
                <TextView
                    android:id="@+id/tvCreatorComplianceBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/status_ok_bg"
                    android:padding="10dp"
                    android:text="@string/status_creator_safe"
                    android:textColor="@color/status_ok"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
