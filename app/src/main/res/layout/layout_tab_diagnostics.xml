<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_diagnostics"
        style="@style/Widget.CallBridge.MicroLabel" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/section_diagnostics"
        style="@style/Widget.CallBridge.HeroValue"
        android:textSize="20sp" />

    <!-- Self-Test Pill Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestBle"
            style="@style/Widget.CallBridge.PillAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_pill_btn"
            android:text="@string/action_test_ble"
            android:textColor="@color/brand_text_on_dark" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestWss"
            style="@style/Widget.CallBridge.PillAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_pill_btn"
            android:text="@string/action_test_wss"
            android:textColor="@color/brand_text_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestMicDiag"
            style="@style/Widget.CallBridge.PillAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_pill_btn"
            android:text="@string/action_test_mic"
            android:textColor="@color/brand_text_primary" />
    </LinearLayout>

    <!-- Latest Diagnostic Result Pill Tile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_soft_tile"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvLastDiagnosticResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="—"
            android:textColor="@color/brand_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Console Section Header + Clear Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_event_log"
            style="@style/Widget.CallBridge.MicroLabel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClearLogs"
            style="@style/Widget.CallBridge.PermGrantPill"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/action_clear_logs" />
    </LinearLayout>

    <!-- Midnight Rounded Live Event Console -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal_card"
        android:clipToOutline="true"
        android:padding="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEventLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </FrameLayout>

</LinearLayout>
