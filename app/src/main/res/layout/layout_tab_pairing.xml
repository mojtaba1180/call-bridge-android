<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CallBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.CallBridge.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_qr_pairing" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/status_neutral_bg"
                    android:padding="10dp"
                    android:text="@string/pairing_qr_notice"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ivPairingQrCode"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/section_qr_pairing"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_pairing_pin" />
                <TextView
                    android:id="@+id/tvPairingPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="------"
                    android:textColor="@color/brand_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_paired_device" />
                <TextView
                    android:id="@+id/tvPairedDevice"
                    style="@style/Widget.CallBridge.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_not_paired" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_android_device_id" />
                <TextView
                    android:id="@+id/tvAndroidDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="—"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Widget.CallBridge.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_tls_fingerprint" />
                <TextView
                    android:id="@+id/tvTlsFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="—"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegenerateQr"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/action_regenerate_qr"
                    app:cornerRadius="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnectIphone"
                        style="@style/Widget.CallBridge.ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_disconnect_iphone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRevokePairing"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_revoke_pairing"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
