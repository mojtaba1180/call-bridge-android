<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Pairing Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_paired_device"
            style="@style/Widget.CallBridge.MicroLabel" />

        <TextView
            android:id="@+id/tvPairedDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_not_paired"
            style="@style/Widget.CallBridge.HeroValue" />

        <!-- Minimalist QR Frame Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_soft_tile"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:background="@drawable/bg_white_inner_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivPairingQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/section_qr_pairing"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_pairing_pin"
                style="@style/Widget.CallBridge.MicroLabel" />

            <TextView
                android:id="@+id/tvPairingPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.22"
                android:text="------"
                android:textColor="@color/brand_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/pairing_qr_notice"
                android:textColor="@color/brand_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Primary Action + Secondary Controls -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegenerateQr"
            style="@style/Widget.CallBridge.PillAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_pill_btn"
            android:text="@string/action_regenerate_qr"
            android:textColor="@color/brand_text_on_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDisconnectIphone"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_pill_btn"
                android:text="@string/action_disconnect_iphone"
                android:textColor="@color/brand_text_primary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRevokePairing"
                style="@style/Widget.CallBridge.PillAction"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_pill_btn"
                android:text="@string/action_revoke_pairing"
                android:textColor="@color/status_error" />
        </LinearLayout>

        <!-- Minimalist Technical Metadata Tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_android_device_id"
                style="@style/Widget.CallBridge.MicroLabel" />

            <TextView
                android:id="@+id/tvAndroidDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="—"
                android:textColor="@color/brand_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/brand_card_stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_tls_fingerprint"
                style="@style/Widget.CallBridge.MicroLabel" />

            <TextView
                android:id="@+id/tvTlsFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono"
                android:lineSpacingExtra="2dp"
                android:text="—"
                android:textColor="@color/brand_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
